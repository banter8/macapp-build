/* ═══════════════════════════════════════
   Video Cutter Pro — 모던 다크 테마
   PySide6 스타일시트
   ═══════════════════════════════════════ */

/* ── 기본 위젯 ─────────────────────────── */
QWidget {
    background-color: #1a1b1e;
    color: #c9d1d9;
    font-family: "Segoe UI", "Noto Sans KR", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #1a1b1e;
}

/* ── 메뉴바 ───────────────────────────── */
QMenuBar {
    background-color: #16181c;
    border-bottom: 1px solid #30363d;
    padding: 2px;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #30363d;
}

QMenu {
    background-color: #21262d;
    border: 1px solid #30363d;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1f6feb;
}

/* ── 툴바 ─────────────────────────────── */
QToolBar {
    background-color: #16181c;
    border-bottom: 1px solid #30363d;
    spacing: 4px;
    padding: 2px 8px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    color: #c9d1d9;
}

QToolButton:hover {
    background-color: #30363d;
    border-color: #484f58;
}

QToolButton:pressed {
    background-color: #1f6feb;
}

/* ── Splitter ─────────────────────────── */
QSplitter::handle {
    background-color: #30363d;
    width: 2px;
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #1f6feb;
}

/* ── 트리 뷰 / 리스트 뷰 ────────────── */
QTreeView, QListView, QListWidget {
    background-color: #16181c;
    border: 1px solid #30363d;
    border-radius: 6px;
    alternate-background-color: #1c1f26;
    outline: none;
}

QTreeView::item, QListView::item, QListWidget::item {
    padding: 4px 8px;
    border-radius: 4px;
}

QTreeView::item:selected, QListView::item:selected, QListWidget::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

QTreeView::item:hover, QListView::item:hover, QListWidget::item:hover {
    background-color: #30363d;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: none;
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: none;
}

/* ── 푸시 버튼 ────────────────────────── */
QPushButton {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #484f58;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
}

QPushButton:pressed {
    background-color: #1f6feb;
    border-color: #1f6feb;
}

QPushButton:disabled {
    background-color: #16181c;
    color: #484f58;
    border-color: #30363d;
}

/* ── 모드 선택 버튼 (체크 가능) ──────── */
QPushButton[cssClass="modeBtn"] {
    background-color: #21262d;
    border: 2px solid #30363d;
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 600;
    text-align: left;
}

QPushButton[cssClass="modeBtn"]:checked {
    background-color: #0d419d;
    border-color: #1f6feb;
}

QPushButton[cssClass="modeBtn"]:hover {
    border-color: #58a6ff;
}

/* ── 슬라이더 ─────────────────────────── */
QSlider::groove:horizontal {
    background: #30363d;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #58a6ff;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #79c0ff;
}

QSlider::sub-page:horizontal {
    background: #1f6feb;
    border-radius: 3px;
}

/* ── 프로그레스 바 ───────────────────── */
QProgressBar {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 6px;
    text-align: center;
    color: #c9d1d9;
    font-size: 12px;
    height: 22px;
}

QProgressBar::chunk {
    background-color: #1f6feb;
    border-radius: 5px;
}

/* ── 라인 에디트 / 스핀 박스 ────────── */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #16181c;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px 8px;
    color: #c9d1d9;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #1f6feb;
}

/* ── 콤보 박스 ───────────────────────── */
QComboBox {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px 8px;
    color: #c9d1d9;
}

QComboBox:hover {
    border-color: #484f58;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #21262d;
    border: 1px solid #30363d;
    selection-background-color: #1f6feb;
}

/* ── 텍스트 에디트 / 브라우저 ────────── */
QTextEdit, QPlainTextEdit {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #c9d1d9;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
}

/* ── 그룹 박스 ───────────────────────── */
QGroupBox {
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-top: 16px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #58a6ff;
}

/* ── 라벨 ─────────────────────────────── */
QLabel {
    color: #c9d1d9;
}

QLabel[cssClass="title"] {
    font-size: 16px;
    font-weight: 700;
    color: #f0f6fc;
}

QLabel[cssClass="subtitle"] {
    font-size: 12px;
    color: #8b949e;
}

QLabel[cssClass="badge"] {
    background-color: #1f6feb;
    border-radius: 10px;
    padding: 2px 8px;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
}

/* ── 상태 표시줄 ─────────────────────── */
QStatusBar {
    background-color: #16181c;
    border-top: 1px solid #30363d;
    color: #8b949e;
}

/* ── 툴팁 ─────────────────────────────── */
QToolTip {
    background-color: #21262d;
    border: 1px solid #484f58;
    border-radius: 4px;
    color: #c9d1d9;
    padding: 4px 8px;
}

/* ── 스크롤바 ─────────────────────────── */
QScrollBar:vertical {
    background: #16181c;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #484f58;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #16181c;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── 체크박스 / 라디오 버튼 ────────── */
QCheckBox, QRadioButton {
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

/* ── 탭 위젯 ─────────────────────────── */
QTabWidget::pane {
    border: 1px solid #30363d;
    border-top: none;
    background-color: #16181c;
}

QTabBar::tab {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-bottom: none;
    padding: 6px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #16181c;
    border-bottom: 2px solid #1f6feb;
}

QTabBar::tab:hover:!selected {
    background-color: #30363d;
}
